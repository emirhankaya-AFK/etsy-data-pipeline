APP_ENV=development
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@db:5432/pipeline

# "demo" works offline. Use "playwright" only for targets you are authorized to collect.
COLLECTOR_MODE=demo
TARGET_URL=
ALLOWED_HOSTS=["www.etsy.com","etsy.com"]
SCHEDULE_HOURS=6
MAX_LISTINGS_PER_RUN=100
REQUEST_TIMEOUT_MS=30000
HEADLESS=true
